# LITEROS — Sample Environment Configuration
# Copy this file to `.env` and update values for your environment.

# Application Mode: "development" or "production"
# Set to "production" to hide seeded passwords/PINs and demo login cards from the login screen.
APP_ENV=development

# Database Configuration
# DB_DRIVER: "auto" (try MySQL, fall back to SQLite), "mysql", or "sqlite"
DB_DRIVER=auto
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=literos
DB_USER=root
DB_PASS=
DB_SQLITE_PATH=database/literos_local.sqlite
